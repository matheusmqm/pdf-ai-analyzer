# Supabase (Project Settings > API). Used only as Postgres + Storage; there is no login.
SUPABASE_URL=https://<project-ref>.supabase.co
# Backend only. NEVER in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pdfs
# Frontend origin allowed by CORS. The API has no authentication: run it locally only.
FRONTEND_URL=http://localhost:5173

# Claude API (console.anthropic.com/settings/keys). Called only when a question is asked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high (lower = faster and cheaper)
ANTHROPIC_EFFORT=low
MAX_OUTPUT_TOKENS=2048
# Maximum time (seconds) to wait for the model to answer.
LLM_TIMEOUT_SECONDS=120

# Local embeddings (Ollama on the host). First: ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Must match vector(N) in schema.sql
EMBEDDING_DIM=1024
# Chunking (approximate tokens) and number of chunks sent to Claude.
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=8

# Upload limit (MB) and lifetime of the download/view link (seconds).
MAX_UPLOAD_MB=20
DOWNLOAD_URL_EXPIRES_SECONDS=300

# Spreadsheets (Excel/CSV): when the agent runs, its limits and the SQL sandbox.
# A spreadsheet is used only if one of its cards has cosine similarity >= SHEET_MIN_SIMILARITY
# with the question (lower = used more often). Below that, only the PDFs are used.
SHEET_TOP_K=3
SHEET_MIN_SIMILARITY=0.45
MAX_AGENT_STEPS=6
SQL_MAX_ROWS=50
SQL_TIMEOUT_SECONDS=15
# USD per million tokens, only to show the estimated cost of each answer (Haiku 5.5 defaults).
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
