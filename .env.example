# Supabase (Project Settings > API). Em dev local: `supabase status`.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Só para projetos com a chave JWT legada (HS256). Deixe vazio com chaves assimétricas.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=pdfs
# Frontend React: destino do link de login do e-mail e origem liberada no CORS.
FRONTEND_URL=http://localhost:5173
# OpenRouter (openrouter.ai/keys). Modelos gratuitos terminam em ":free" (openrouter.ai/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=provedor/modelo:free
# Tempo máximo (segundos) esperando o modelo responder.
LLM_TIMEOUT_SECONDS=120
