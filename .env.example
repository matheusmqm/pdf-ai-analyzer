# Supabase (Project Settings > API). Usado só como Postgres + Storage; não há login.
SUPABASE_URL=https://<project-ref>.supabase.co
# Só backend. NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pdfs
# Origem do frontend liberada no CORS. A API não tem autenticação: rode só localmente.
FRONTEND_URL=http://localhost:5173

# Claude API (console.anthropic.com/settings/keys). Chamada só ao fazer uma pergunta.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high (menos = mais rápido e barato)
ANTHROPIC_EFFORT=low
MAX_OUTPUT_TOKENS=2048
# Tempo máximo (segundos) esperando o modelo responder.
LLM_TIMEOUT_SECONDS=120

# Limite de upload (MB) e validade do link de download/visualização (segundos).
MAX_UPLOAD_MB=20
DOWNLOAD_URL_EXPIRES_SECONDS=300
